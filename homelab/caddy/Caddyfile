{
	admin off
	# tailnet 주소에 80번(HTTP→HTTPS 리다이렉트)을 열지 않는다
	auto_https disable_redirects
}

# 같이 보는 공간. 비밀번호 보호.
http://hwjs.ckaanf.com:8080 {
	bind 127.0.0.1
	root * /var/www/hwjs
	basic_auth {
		ckaanf {$HWJS_BASICAUTH_HASH}
	}
	file_server
}

# 위에 없는 도메인으로 들어온 요청은 거절한다.
http://:8080 {
	bind 127.0.0.1
	respond 404
}

# tailnet 전용 내부 주소. *.ckaanf.com 와일드카드 인증서(Cloudflare DNS 인증).
# 공개 DNS의 A 레코드가 tailnet IP를 가리켜서 tailnet 기기에서만 열린다.
*.ckaanf.com {
	bind {$TAILNET_IP}
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	@js host js.ckaanf.com
	handle @js {
		root * /var/www/js
		header /meal/* Cache-Control "no-cache"
		reverse_proxy /meal/api/* 127.0.0.1:8083
		file_server
	}

	@kuma host kuma.ckaanf.com
	handle @kuma {
		reverse_proxy 127.0.0.1:3001
	}

	@portainer host portainer.ckaanf.com
	handle @portainer {
		reverse_proxy https://127.0.0.1:9443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	handle {
		respond 404
	}
}
