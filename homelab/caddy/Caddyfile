{
	admin off
}

# 같이 보는 공간. 비밀번호 보호.
http://hwjs.ckaanf.com:8080 {
	bind 127.0.0.1
	root * /var/www/hwjs
	basicauth {
		ckaanf {$HWJS_BASICAUTH_HASH}
	}
	file_server
}

# 개인 공간. Tailscale 전용 (tailscale serve :8444 → 여기). 인터넷에는 열지 않는다.
http://:8082 {
	bind 127.0.0.1
	root * /var/www/js
	header /meal/* Cache-Control "no-cache"
	reverse_proxy /meal/api/* 127.0.0.1:8083
	file_server
}

# 위에 없는 도메인으로 들어온 요청은 거절한다.
http://:8080 {
	bind 127.0.0.1
	respond 404
}
