# oci-relaunch 설정 예시. 맥의 ~/.config/oci-relaunch/env 로 복사해 채운다.
# 비밀값 없음 — 인증은 ~/.oci/config(API 키)가 맡는다. 실제 OCID는 공개 저장소에 올리지 않는다.
COMPARTMENT_ID=ocid1.tenancy.oc1..<테넌시>
AVAILABILITY_DOMAIN=<AD 이름, 예: xxxx:AP-TOKYO-1-AD-1>
SUBNET_ID=ocid1.subnet.oc1.ap-tokyo-1.<서브넷>
BOOT_VOLUME_ID=ocid1.bootvolume.oc1.ap-tokyo-1.<남은 부트 볼륨>

# 무료 한도(A1 2코어·12GB)와 할당량 정책 free-tier-guard 안에서만
OCPUS=2
MEMORY_GB=12
DISPLAY_NAME=oracle
ASSIGN_PUBLIC_IP=true
